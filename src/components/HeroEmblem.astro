---
/**
 * Emblema geométrico de un héroe: hexágono con el color del héroe y un glifo
 * por pilar o territorio (arma, escudo, runa, luna, martillo).
 *
 * Sustituye al retrato mientras el arte del juego sea provisional: el dueño
 * decidió no publicar los placeholders generados por IA (docs/MEMORIA.md).
 * Es decorativo: el nombre del héroe siempre va en texto al lado.
 *
 * Los colores van en CSS y no en atributos de presentación (`fill="..."`),
 * porque los atributos SVG no resuelven var().
 */
import type { HeroGlyph } from '~/i18n/pages/heroes';

interface Props {
  heroId: string;
  glyph: HeroGlyph;
  /** Lado en píxeles. El SVG escala; esto solo fija la caja. */
  size?: number;
}

const { heroId, glyph, size = 64 } = Astro.props;
const gradientId = `emblem-${heroId}-${size}`;
---

<svg
  class="emblem"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
  style={`--hero: var(--hd-hero-${heroId})`}
>
  <defs>
    <radialGradient id={gradientId} cx="50%" cy="38%" r="65%">
      <stop offset="0%" style="stop-color: var(--hero); stop-opacity: 0.38"></stop>
      <stop offset="100%" style="stop-color: var(--hero); stop-opacity: 0.04"></stop>
    </radialGradient>
  </defs>
  <polygon
    class="frame"
    points="32,3 57,17.5 57,46.5 32,61 7,46.5 7,17.5"
    style={`fill: url(#${gradientId})`}
  />
  <g class="glyph">
    {
      glyph === 'blade' && (
        <>
          <path class="solid" d="M32 11 L37 19 L37 38 L27 38 L27 19 Z" />
          <path class="line" d="M21 40 H43" stroke-width="3.5" />
          <path class="line" d="M32 41 V49" stroke-width="4" />
          <circle class="solid" cx="32" cy="52" r="2.6" />
        </>
      )
    }
    {
      glyph === 'shield' && (
        <>
          <path
            class="line"
            d="M32 13 L46 18.5 V30 C46 40 40 46.5 32 51 C24 46.5 18 40 18 30 V18.5 Z"
            stroke-width="3.5"
          />
          <path class="line" d="M32 21 V44 M24 28 H40" stroke-width="3" />
        </>
      )
    }
    {
      glyph === 'rune' && (
        <>
          <path class="line" d="M32 11 L46 32 L32 53 L18 32 Z" stroke-width="3" />
          <path class="solid" d="M32 22 L39 32 L32 42 L25 32 Z" />
        </>
      )
    }
    {
      glyph === 'crescent' && (
        <>
          <path class="solid" d="M44 14 A19 19 0 1 0 44 50 A22 22 0 0 1 44 14 Z" />
          <circle class="solid" cx="44" cy="25" r="2" />
        </>
      )
    }
    {
      glyph === 'hammer' && (
        <>
          <path class="solid" d="M19 15 H45 V28 H19 Z" />
          <path class="line" d="M32 29 V52" stroke-width="5" />
          <path class="crack" d="M37 15 L34 20.5 L38 23.5 L35 28" stroke-width="2" />
        </>
      )
    }
  </g>
</svg>

<style>
  .emblem {
    flex: none;
  }

  .frame {
    stroke: var(--hero);
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .solid {
    fill: var(--hero);
  }

  .line,
  .crack {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .line {
    stroke: var(--hero);
  }

  .crack {
    stroke: var(--hd-surface);
  }
</style>
