---
import { Picture } from 'astro:assets';
import { brandEmblem } from '~/art';
import wildcatLogo from '~/assets/brand/wildcat-games.png';
import { localizedPath, useTranslations, type Lang } from '~/i18n/ui';
import { isLegalPublished, legalDocs } from '~/legal';
import { developer } from '~/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/* Ano de copyright fijado en build. El sitio es estático: no hay reloj en runtime. */
const year = new Date().getFullYear();

/* Los legales solo se enlazan publicados: un borrador enlazado desde el pie se
   lee como la política vigente (src/legal.ts). */
const legalLinks = legalDocs.filter(isLegalPublished);
---

<footer class="site-footer">
  <div class="container bar">
    <div class="brand">
      <Picture src={brandEmblem} alt="" formats={['avif', 'webp']} widths={[64, 128]} sizes="2.5rem" class="emblem emblem-fade" />
      <div>
        <p class="line">
          &copy; {year} {t('site.name')}. {t('footer.rights')}
        </p>
        <p class="line">{t('footer.art')}</p>
      </div>
    </div>
    <a class="studio" href={developer.url}>
      <span>{t('footer.developer')}</span>
      <Picture
        src={wildcatLogo}
        alt={developer.name}
        formats={['avif', 'webp']}
        widths={[96, 192]}
        sizes="5.5rem"
        class="studio-logo"
      />
    </a>
    {
      legalLinks.length > 0 && (
        <nav aria-label={t('nav.legal')}>
          <ul class="links">
            {legalLinks.map((doc) => (
              <li>
                <a href={localizedPath(lang, doc)}>{t(`nav.${doc}`)}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--hd-border-gold);
    background: var(--hd-surface-sunken);
    padding-block: var(--hd-space-6);
    font-size: var(--hd-text-sm);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--hd-space-4);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--hd-space-3);
  }

  .brand :global(.emblem) {
    inline-size: 2.5rem;
    block-size: 2.5rem;
    object-fit: contain;
  }

  /* El lettering del logo es el nombre del estudio: va como imagen, nunca como
     texto, y su texto alternativo completa "Desarrollado por". */
  .studio {
    display: inline-flex;
    align-items: center;
    gap: var(--hd-space-3);
    color: var(--hd-text-muted);
    text-decoration: none;
  }

  .studio:hover {
    color: var(--hd-text);
  }

  .studio :global(.studio-logo) {
    inline-size: 5.5rem;
    block-size: 5.5rem;
    object-fit: contain;
  }

  .line {
    margin: 0;
    max-width: none;
    color: var(--hd-text-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hd-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    color: var(--hd-text-muted);
  }

  .links a:hover {
    color: var(--hd-text);
  }
</style>
