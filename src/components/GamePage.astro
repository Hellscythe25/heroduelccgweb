---
import { Picture } from 'astro:assets';
import PageHead from '~/components/PageHead.astro';
import { cardTypeArt, currencyIcons, scenes } from '~/art';
import CtaLink from '~/components/CtaLink.astro';
import { gameCopy } from '~/i18n/pages/game';
import { howToPlayCopy } from '~/i18n/pages/howToPlay';
import { localizedPath, useTranslations, type Lang } from '~/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const copy = gameCopy[lang];
---

<PageHead title={copy.title} lead={copy.lead} art={scenes.duel} />

<section class="section container" aria-labelledby="pillars">
  <h2 id="pillars">{copy.pillars.title}</h2>
  <ul class="grid">
    {
      copy.pillars.items.map((item) => (
        <li class="panel">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))
    }
  </ul>
</section>

<section class="section container" aria-labelledby="modes">
  <h2 id="modes">{copy.modes.title}</h2>
  <div class="modes">
    <div>
      <h3 class="subhead">{copy.modes.pvp.title}</h3>
      <dl class="mode-list">
        {
          copy.modes.pvp.items.map((item) => (
            <div>
              <dt>{item.title}</dt>
              <dd>{item.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="panel pve">
      <Picture
        src={scenes.campaign}
        alt=""
        formats={['avif', 'webp']}
        widths={[480, 800]}
        sizes="(min-width: 52rem) 34rem, 100vw"
        loading="lazy"
        class="pve-art"
      />
      <h3>{copy.modes.pve.title}</h3>
      <p>{copy.modes.pve.body}</p>
      <h3 class="pve-start">{copy.start.title}</h3>
      <p>{copy.start.body}</p>
    </div>
  </div>
</section>

<section class="section container" aria-labelledby="collection">
  <h2 id="collection">{copy.collection.title}</h2>
  <p class="intro">{copy.collection.intro}</p>
  <ul class="card-types">
    {
      copy.collection.types.map((item, index) => (
        <li class="card-frame">
          {cardTypeArt[index] && (
            <Picture
              src={cardTypeArt[index]}
              alt=""
              formats={['avif', 'webp']}
              widths={[320, 560]}
              sizes="(min-width: 52rem) 16rem, 50vw"
              loading="lazy"
              class="card-art"
            />
          )}
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))
    }
  </ul>
  <h3 class="subhead">{copy.collection.rarities.title}</h3>
  <p class="intro">{copy.collection.rarities.note}</p>
  <ul class="rarities">
    {
      copy.collection.rarities.items.map((item, index) => (
        <li class={`rarity rarity-${index}`}>
          <span class="rarity-name">{item.name}</span>
          <span class="rarity-copies">×{item.copies}</span>
        </li>
      ))
    }
  </ul>
</section>

<section class="section container" aria-labelledby="currencies">
  <h2 id="currencies">{copy.currencies.title}</h2>
  <p class="intro">{copy.currencies.intro}</p>
  <ul class="currencies">
    {
      copy.currencies.items.map((item, index) => (
        <li class={`currency currency-${index}`}>
          {currencyIcons[index] && (
            <Picture
              src={currencyIcons[index]}
              alt=""
              formats={['avif', 'webp']}
              widths={[96, 192]}
              sizes="4.5rem"
              loading="lazy"
              class="currency-icon"
            />
          )}
          <div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<section class="section container" aria-labelledby="fair">
  <h2 id="fair">{copy.fair.title}</h2>
  <ul class="grid">
    {
      copy.fair.items.map((item) => (
        <li class="panel">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))
    }
  </ul>
</section>

<section class="section container" aria-labelledby="platforms">
  <h2 id="platforms">{copy.platforms.title}</h2>
  <p>{copy.platforms.body}</p>
  <div class="next">
    <CtaLink href={localizedPath(lang, 'howToPlay')}>{howToPlayCopy[lang].title}</CtaLink>
    <CtaLink href={localizedPath(lang, 'heroes')} variant="secondary">{t('nav.heroes')}</CtaLink>
  </div>
</section>

<style>
  /* ---- Tipos de carta como marcos de carta del juego ---- */
  .card-types {
    display: grid;
    gap: var(--hd-space-4);
    /* 9.5rem: dos cartas por fila en un teléfono, cuatro en escritorio. */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    margin-block-end: var(--hd-space-8);
    padding: 0;
    list-style: none;
  }

  .card-frame {
    display: grid;
    align-content: start;
    gap: var(--hd-space-2);
    padding: var(--hd-space-2) var(--hd-space-2) var(--hd-space-4);
    border: 1px solid var(--hd-border-gold);
    border-radius: var(--hd-radius-lg);
    background:
      linear-gradient(180deg, var(--hd-gold-sheen), transparent 40%),
      var(--hd-surface-raised);
    box-shadow:
      inset 0 0 0 4px var(--hd-surface-raised),
      inset 0 0 0 5px var(--hd-gold-wash);
    transition:
      transform var(--hd-motion-fast) var(--hd-motion-ease),
      border-color var(--hd-motion-fast) var(--hd-motion-ease);
  }

  .card-frame:hover {
    transform: translateY(-3px);
    border-color: var(--hd-accent);
  }

  .card-frame :global(.card-art) {
    inline-size: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--hd-radius-md);
    margin-block-end: var(--hd-space-2);
  }

  .card-frame h3,
  .card-frame p {
    padding-inline: var(--hd-space-3);
  }

  .card-frame h3 {
    font-family: var(--hd-font-display);
    color: var(--hd-accent);
  }

  .card-frame p {
    color: var(--hd-text-muted);
  }

  /* ---- Monedas: píldoras como las de la billetera del juego ---- */
  .currencies {
    display: grid;
    gap: var(--hd-space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    padding: 0;
    list-style: none;
  }

  .currency {
    display: flex;
    align-items: center;
    gap: var(--hd-space-4);
    padding: var(--hd-space-4);
    border: 1px solid var(--currency);
    border-radius: var(--hd-radius-full) var(--hd-radius-lg) var(--hd-radius-lg) var(--hd-radius-full);
    background: linear-gradient(90deg, color-mix(in srgb, var(--currency) 12%, transparent), transparent 70%);
  }

  .currency-0 {
    --currency: var(--hd-accent);
  }
  .currency-1 {
    --currency: var(--hd-essence);
  }
  .currency-2 {
    --currency: var(--hd-gems);
  }

  .currency :global(.currency-icon) {
    flex: none;
    inline-size: 4.5rem;
    block-size: 4.5rem;
    filter: drop-shadow(0 0 12px color-mix(in srgb, var(--currency) 45%, transparent));
  }

  .currency h3 {
    color: var(--currency);
  }

  .currency p {
    color: var(--hd-text-muted);
  }

  .modes {
    display: grid;
    gap: var(--hd-space-8);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    align-items: start;
  }

  .subhead {
    margin-block: var(--hd-space-8) var(--hd-space-3);
    color: var(--hd-accent);
  }

  .modes .subhead {
    margin-block-start: 0;
  }

  .mode-list {
    display: grid;
    gap: var(--hd-space-4);
  }

  .mode-list dt {
    font-weight: 700;
  }

  .mode-list dd {
    margin: 0;
    color: var(--hd-text-muted);
  }

  .pve {
    overflow: hidden;
    border-color: var(--hd-border-gold);
  }

  /* La ilustración ocupa el ancho del panel, de borde a borde. */
  .pve :global(.pve-art) {
    inline-size: calc(100% + 2 * var(--hd-space-6));
    max-inline-size: none;
    aspect-ratio: 16 / 7;
    margin: calc(-1 * var(--hd-space-6)) calc(-1 * var(--hd-space-6)) var(--hd-space-6);
    object-fit: cover;
  }

  .pve-start {
    margin-block-start: var(--hd-space-6);
  }

  .intro {
    margin-block-end: var(--hd-space-4);
    color: var(--hd-text-muted);
  }


  /* Colores de rareza del juego (Theme.uss), solo como borde: el texto va
     siempre en el color de texto, que pasa AA. */
  .rarities {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hd-space-3);
    padding: 0;
    list-style: none;
  }

  .rarity {
    display: flex;
    align-items: baseline;
    gap: var(--hd-space-3);
    padding: var(--hd-space-2) var(--hd-space-4);
    border: 1px solid var(--rarity);
    border-inline-start-width: 4px;
    border-radius: var(--hd-radius-md);
    background: var(--hd-surface-raised);
  }

  .rarity-0 {
    --rarity: var(--hd-rarity-common);
  }
  .rarity-1 {
    --rarity: var(--hd-rarity-uncommon);
  }
  .rarity-2 {
    --rarity: var(--hd-rarity-rare);
  }
  .rarity-3 {
    --rarity: var(--hd-rarity-epic);
  }
  .rarity-4 {
    --rarity: var(--hd-rarity-legendary);
  }

  .rarity-name {
    font-weight: 600;
  }

  .rarity-copies {
    color: var(--hd-text-muted);
    font-variant-numeric: tabular-nums;
  }


  .next {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hd-space-3);
    margin-block-start: var(--hd-space-8);
  }
</style>
