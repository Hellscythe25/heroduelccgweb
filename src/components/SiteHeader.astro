---
import { Picture } from 'astro:assets';
import { brandEmblem } from '~/art';
import { localizedPath, locales, languages, useTranslations, type Lang, type RouteKey } from '~/i18n/ui';
import { isPressKitPublishable } from '~/press';
import { hasDevlogPosts } from '~/devlog';

interface Props {
  lang: Lang;
  /** Ruta actual, para marcar el enlace activo y cambiar de idioma sin perder la página. */
  routeKey: RouteKey;
}

const { lang, routeKey } = Astro.props;
const t = useTranslations(lang);

/* La navegación crece solo cuando la sección existe de verdad: un menú con
   enlaces a páginas vacías o a 404 se lee como un sitio abandonado.
   El devlog aparece con su primera entrada; el kit de prensa, cuando deja de
   estar en borrador (src/press.ts). El inicio no lleva enlace propio: la marca
   ya lo es, y así el menú cabe en dos líneas en un teléfono. */
const nav: { key: RouteKey; label: string }[] = [
  { key: 'game', label: t('nav.game') },
  { key: 'howToPlay', label: t('nav.howToPlay') },
  { key: 'heroes', label: t('nav.heroes') },
  ...(hasDevlogPosts(lang) ? [{ key: 'blog' as const, label: t('nav.blog') }] : []),
  ...(isPressKitPublishable ? [{ key: 'presskit' as const, label: t('nav.presskit') }] : []),
];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localizedPath(lang, 'home')} aria-current={routeKey === 'home' ? 'page' : undefined}>
      <Picture
        src={brandEmblem}
        alt=""
        formats={['avif', 'webp']}
        widths={[48, 96]}
        sizes="48px"
        loading="eager"
        class="brand-mark emblem-fade"
      />
      <span class="brand-name">{t('site.name')}</span>
    </a>

    <nav class="lang-switch" aria-label={t('nav.language')}>
      <ul class="nav-list">
        {
          locales.map((code) => (
            <li>
              <a
                href={localizedPath(code, routeKey)}
                hreflang={code}
                lang={code}
                aria-current={code === lang ? 'true' : undefined}
              >
                {languages[code]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="main-nav" aria-label={t('nav.main')}>
      <ul class="nav-list">
        {
          nav.map((item) => (
            <li>
              <a href={localizedPath(lang, item.key)} aria-current={item.key === routeKey ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Fija y translúcida: el arte se intuye al pasar por debajo. */
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    border-bottom: 1px solid var(--hd-border-gold);
    background: var(--hd-veil-strong);
    backdrop-filter: blur(12px) saturate(1.2);
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'brand lang'
      'nav nav';
    align-items: center;
    gap: var(--hd-space-2) var(--hd-space-4);
    padding-block: var(--hd-space-3);
  }

  .brand {
    grid-area: brand;
    display: inline-flex;
    align-items: center;
    gap: var(--hd-space-2);
    justify-self: start;
    min-block-size: 2.75rem;
    color: var(--hd-text);
    font-family: var(--hd-font-display);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  /* Emblema del juego (yunque y cartas), el mismo de la pantalla de carga. */
  .brand :global(.brand-mark) {
    inline-size: 2.5rem;
    block-size: 2.5rem;
    object-fit: contain;
  }

  .brand-name {
    white-space: nowrap;
  }

  @media (min-width: 52rem) {
    .brand :global(.brand-mark) {
      inline-size: 3rem;
      block-size: 3rem;
    }
  }

  .main-nav {
    grid-area: nav;
  }

  .lang-switch {
    grid-area: lang;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--hd-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--hd-text-sm);
  }

  .nav-list a {
    display: inline-flex;
    align-items: center;
    /* Objetivo táctil de 44 px también en el menú. */
    min-block-size: 2.75rem;
    color: var(--hd-text-muted);
    text-decoration: none;
  }

  .nav-list a:hover {
    color: var(--hd-text);
    text-decoration: underline;
  }

  .nav-list a[aria-current] {
    color: var(--hd-accent);
    font-weight: 600;
  }

  @media (min-width: 52rem) {
    .bar {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand nav lang';
    }

    .main-nav {
      justify-self: end;
    }

    .lang-switch {
      padding-inline-start: var(--hd-space-4);
      border-inline-start: 1px solid var(--hd-border);
    }
  }
</style>
