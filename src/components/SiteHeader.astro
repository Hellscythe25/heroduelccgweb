---
import { localizedPath, locales, languages, useTranslations, type Lang, type RouteKey } from '~/i18n/ui';

interface Props {
  lang: Lang;
  /** Ruta actual, para marcar el enlace activo y cambiar de idioma sin perder la página. */
  routeKey: RouteKey;
}

const { lang, routeKey } = Astro.props;
const t = useTranslations(lang);

/* Fase 0 solo publica la home. La navegación crece cuando cada sección existe:
   un menú con enlaces a páginas 404 se lee como un sitio roto. */
const nav: { key: RouteKey; label: string }[] = [{ key: 'home', label: t('nav.home') }];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localizedPath(lang, 'home')}>
      <span class="brand-mark" aria-hidden="true">HD</span>
      <span class="brand-name">{t('site.name')}</span>
    </a>

    <nav aria-label={t('nav.home')}>
      <ul class="nav-list">
        {
          nav.map((item) => (
            <li>
              <a href={localizedPath(lang, item.key)} aria-current={item.key === routeKey ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="lang-switch" aria-label={t('nav.language')}>
      <ul class="nav-list">
        {
          locales.map((code) => (
            <li>
              <a
                href={localizedPath(code, routeKey)}
                hreflang={code}
                lang={code}
                aria-current={code === lang ? 'true' : undefined}
              >
                {languages[code]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--hd-border);
    background: var(--hd-surface-sunken);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--hd-space-4);
    padding-block: var(--hd-space-3);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--hd-space-2);
    color: var(--hd-text);
    font-weight: 700;
    text-decoration: none;
    margin-inline-end: auto;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: var(--hd-radius-md);
    background: var(--hd-accent);
    color: var(--hd-accent-contrast);
    font-size: var(--hd-text-sm);
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--hd-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--hd-text-sm);
  }

  .nav-list a {
    color: var(--hd-text-muted);
    text-decoration: none;
  }

  .nav-list a:hover {
    color: var(--hd-text);
    text-decoration: underline;
  }

  .nav-list a[aria-current] {
    color: var(--hd-accent);
    font-weight: 600;
  }

  .lang-switch {
    padding-inline-start: var(--hd-space-4);
    border-inline-start: 1px solid var(--hd-border);
  }
</style>
