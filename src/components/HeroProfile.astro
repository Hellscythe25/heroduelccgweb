---
/**
 * Ficha completa de un héroe para /heroes/: retrato sobre su arena del juego,
 * y al lado sus reglas.
 *
 * Reglas (vida, pasiva, habilidades, costes) desde src/data/ (canon del juego);
 * rol y estilo desde src/i18n/pages/heroes.ts; arte desde src/art.ts. Nada se
 * calcula ni se redondea. Sin retrato, cae al emblema geométrico.
 */
import { Picture } from 'astro:assets';
import HeroEmblem from '~/components/HeroEmblem.astro';
import { heroArena, heroPortrait } from '~/art';
import { heroPresentation } from '~/i18n/pages/heroes';
import { useTranslations, type Lang } from '~/i18n/ui';
import type { Hero } from '~/data';

interface Props {
  hero: Hero;
  lang: Lang;
  /** Vida más alta del roster, para escalar la barra de vida. */
  maxLife: number;
  /** Retrato a la derecha en escritorio, para alternar el ritmo de la página. */
  flip?: boolean;
}

const { hero, lang, maxLife, flip = false } = Astro.props;
const t = useTranslations(lang);
const presentation = heroPresentation[hero.id]!;
const portrait = heroPortrait(hero.id);
const arena = heroArena(hero.id);

// "Brakka Furia de Hierro" -> "Brakka" + "Furia de Hierro". El nombre completo
// sigue en el h2 para lectores de pantalla; la partición es solo visual.
const [shortName, ...rest] = hero.name[lang].split(' ');
const epithet = rest.join(' ');
const lifePercent = Math.round((hero.life / maxLife) * 100);
---

<article
  class:list={['hero', { flip }]}
  id={hero.id}
  style={`--hero: var(--hd-hero-${hero.id}); --hero-text: var(--hd-hero-${hero.id}-text)`}
>
  <div class="art">
    {
      arena && (
        <Picture
          src={arena}
          alt=""
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(min-width: 60rem) 30rem, 100vw"
          loading="lazy"
          class="arena"
        />
      )
    }
    {
      portrait ? (
        <Picture
          src={portrait}
          alt={t('hero.portrait').replace('{name}', shortName!)}
          formats={['avif', 'webp']}
          widths={[320, 480, 720]}
          sizes="(min-width: 60rem) 22rem, 80vw"
          loading="lazy"
          class="portrait"
        />
      ) : (
        <HeroEmblem heroId={hero.id} glyph={presentation.glyph} size={160} />
      )
    }
  </div>

  <div class="info">
    <h2>
      <span class="name">{shortName}</span>
      {epithet && <span class="epithet">{epithet}</span>}
    </h2>
    <p class="role">{presentation.role[lang]}</p>
    <p class="style">{presentation.style[lang]}</p>

    <div class="life">
      <p>
        <span class="label">{t('hero.life')}</span>
        <span class="life-value">{hero.life}</span>
      </p>
      <div class="life-bar" aria-hidden="true"><span style={`inline-size: ${lifePercent}%`}></span></div>
    </div>

    <section class="block" aria-labelledby={`${hero.id}-passive`}>
      <h3 id={`${hero.id}-passive`}>
        <span class="label">{t('hero.passive')}</span>
        {hero.passive.name[lang]}
      </h3>
      <p class="rule">{hero.passive.text[lang]}</p>
    </section>

    <section class="block" aria-labelledby={`${hero.id}-abilities`}>
      <h3 id={`${hero.id}-abilities`} class="label">{t('hero.abilities')}</h3>
      <ul class="abilities">
        {
          hero.actives.map((ability) => (
            <li>
              <p class="ability-head">
                <span class="cost">
                  <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">
                    <path d="M9.5 1 3 9h4.5L6.5 15 13 7H8.5z" />
                  </svg>
                  <span class="visually-hidden">{t('hero.cost')}:</span>
                  {ability.cost}
                  <span class="visually-hidden">{t('hero.energy')}</span>
                </span>
                <strong>{ability.name[lang]}</strong>
              </p>
              <p class="rule">{ability.text[lang]}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {
      hero.campaign && (
        <p class="campaign">
          <span class="label">{t('hero.campaign')}</span>
          <em>{hero.campaign.name[lang]}</em>
        </p>
      )
    }
  </div>
</article>

<style>
  .hero {
    display: grid;
    gap: var(--hd-space-8);
    align-items: start;
    padding-block: var(--hd-space-12);
    border-block-start: 1px solid var(--hd-border);
    scroll-margin-block-start: var(--hd-space-6);
  }

  /* ---- Arte: el retrato enmarcado sobre la arena del héroe ---- */
  .art {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    padding: var(--hd-space-8) var(--hd-space-6);
    border-radius: var(--hd-radius-lg);
    overflow: hidden;
    background: var(--hd-surface-raised);
  }

  .art :global(.arena) {
    position: absolute;
    inset: 0;
    z-index: -2;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    filter: brightness(0.55) saturate(0.9);
  }

  .art::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(closest-side, var(--hd-veil-clear), var(--hd-veil));
  }

  .art :global(.portrait) {
    inline-size: min(100%, 20rem);
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 15%;
    border: 1px solid var(--hero);
    border-radius: var(--hd-radius-md);
    box-shadow:
      0 0 0 6px var(--hd-veil),
      var(--hd-shadow-lg);
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: 26rem 1fr;
      gap: var(--hd-space-12);
    }

    .hero.flip {
      grid-template-columns: 1fr 26rem;
    }

    .hero.flip .art {
      order: 2;
    }

    .art {
      position: sticky;
      inset-block-start: var(--hd-space-6);
      min-block-size: 32rem;
    }
  }

  /* ---- Datos ---- */
  .info {
    display: grid;
    gap: var(--hd-space-4);
    max-inline-size: var(--hd-measure);
  }

  h2 {
    display: grid;
    gap: var(--hd-space-1);
    font-size: var(--hd-text-3xl);
  }

  .name {
    color: var(--hd-text);
  }

  .epithet {
    font-family: var(--hd-font-sans);
    font-size: var(--hd-text-lg);
    font-weight: 700;
    letter-spacing: 0;
    color: var(--hero-text);
  }

  .role {
    color: var(--hd-text-muted);
    font-weight: 700;
  }

  .style {
    font-size: var(--hd-text-lg);
  }

  .label {
    display: block;
    color: var(--hd-text-muted);
    font-family: var(--hd-font-sans);
    font-size: var(--hd-text-sm);
    font-weight: 400;
  }

  .life p {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    max-width: none;
  }

  .life-value {
    font-family: var(--hd-font-display);
    font-size: var(--hd-text-2xl);
    font-weight: 700;
  }

  .life-bar {
    block-size: 6px;
    margin-block-start: var(--hd-space-2);
    background: var(--hd-surface-raised);
    border-radius: var(--hd-radius-full);
    overflow: hidden;
  }

  .life-bar span {
    display: block;
    block-size: 100%;
    background: linear-gradient(90deg, color-mix(in srgb, var(--hero) 55%, transparent), var(--hero));
    border-radius: inherit;
  }

  .block {
    padding-block-start: var(--hd-space-4);
    border-block-start: 1px solid var(--hd-border);
  }

  h3 {
    font-size: var(--hd-text-lg);
  }

  h3 .label {
    margin-block-end: var(--hd-space-1);
  }

  .rule {
    margin-block-start: var(--hd-space-2);
    color: var(--hd-text-muted);
  }

  /* El juego escribe la pasiva en minúscula tras los dos puntos; aquí va en
     su propia línea, así que se capitaliza sin tocar el dato. */
  .rule::first-letter {
    text-transform: uppercase;
  }

  .abilities {
    display: grid;
    gap: var(--hd-space-4);
    margin-block-start: var(--hd-space-3);
    padding: 0;
    list-style: none;
  }

  .ability-head {
    display: flex;
    align-items: center;
    gap: var(--hd-space-3);
  }

  .cost {
    display: inline-flex;
    align-items: center;
    gap: var(--hd-space-1);
    min-inline-size: 2.75rem;
    padding: 0.1rem var(--hd-space-2);
    border: 1px solid var(--hd-border-gold);
    border-radius: var(--hd-radius-full);
    color: var(--hd-accent);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .cost svg {
    fill: currentColor;
  }

  .campaign {
    padding-block-start: var(--hd-space-4);
    border-block-start: 1px solid var(--hd-border);
  }

  .campaign em {
    font-size: var(--hd-text-lg);
  }
</style>
