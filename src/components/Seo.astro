---
/**
 * Metadatos por plantilla — dueño: agente `seo-tecnico`.
 *
 * Regla: ninguna página se publica sin título, descripción e imagen OG.
 *
 * La imagen por defecto la genera `node scripts/generate-og.mjs` a partir de
 * los tokens del sistema de diseño. Se importa como asset para que su URL lleve
 * el hash del contenido: WhatsApp, Discord y X guardan la previsualización por
 * URL, y con un nombre fijo seguían mostrando la imagen anterior tras cambiarla.
 *
 * Una página puede pasar la suya propia —lo hará el compendio, con una imagen
 * por carta—, pero nunca puede quedarse sin ninguna: un enlace sin
 * previsualización en Discord o X se lee como spam.
 */
import defaultOgImage from '~/assets/og/default.png';
import { alternates, localeTags, type Lang, type RouteKey } from '~/i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Clave de ruta, para generar los hreflang de la misma página en otros idiomas. */
  routeKey: RouteKey;
  /** Ruta absoluta a una imagen propia. Si se omite, se usa la del sitio. */
  image?: string | undefined;
  noindex?: boolean;
}

const { title, description, lang, routeKey, image, noindex = false } = Astro.props;

const site = Astro.site;
const canonical = new URL(Astro.url.pathname, site ?? Astro.url.origin);
const imageUrl = new URL(image ?? defaultOgImage.src, site ?? Astro.url.origin);
const links = alternates(routeKey);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

{
  links.map(({ lang: alt, path }) => (
    <link rel="alternate" hreflang={localeTags[alt]} href={new URL(path, site ?? Astro.url.origin).href} />
  ))
}
<link rel="alternate" hreflang="x-default" href={new URL(links[0]?.path ?? '/', site ?? Astro.url.origin).href} />

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:locale" content={localeTags[lang].replace('-', '_')} />
<meta property="og:image" content={imageUrl.href} />
<meta property="og:image:alt" content={title} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl.href} />

<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" href="/favicon/icon-192.png" type="image/png" sizes="192x192" />
<link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
