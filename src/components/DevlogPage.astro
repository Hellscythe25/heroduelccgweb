---
import { getCollection } from 'astro:content';
import PageHead from '~/components/PageHead.astro';
import { hasDevlogPosts } from '~/devlog';
import { localeTags, useTranslations, type Lang } from '~/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Sin entradas no se consulta la colección: Astro avisa en cada build cuando
// está vacía, y ese ruido tapa los avisos que sí importan.
const posts = hasDevlogPosts(lang)
  ? (await getCollection('blog', (entry) => entry.data.lang === lang && !entry.data.draft)).sort(
      (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
    )
  : [];

const dateFormat = new Intl.DateTimeFormat(localeTags[lang], { dateStyle: 'long', timeZone: 'UTC' });
---

<PageHead eyebrow={t('devlog.title')} title={t('devlog.title')} lead={t('devlog.intro')} />

<section class="section container">
  {
    posts.length === 0 ? (
      <p class="empty">{t('devlog.empty')}</p>
    ) : (
      <ul class="posts">
        {posts.map((post) => (
          <li class="panel">
            <h2>{post.data.title}</h2>
            <p class="meta">
              {t('devlog.published')}{' '}
              <time datetime={post.data.publishedAt.toISOString()}>{dateFormat.format(post.data.publishedAt)}</time>
              {' · '}
              {post.data.author}
            </p>
            <p>{post.data.description}</p>
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  .empty {
    color: var(--hd-text-muted);
  }

  .posts {
    display: grid;
    gap: var(--hd-space-4);
    padding: 0;
    list-style: none;
  }

  .posts h2 {
    font-size: var(--hd-text-xl);
  }

  .meta {
    margin-block: var(--hd-space-2);
    font-size: var(--hd-text-sm);
  }
</style>
