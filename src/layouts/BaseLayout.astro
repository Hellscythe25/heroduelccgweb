---
import '~/styles/global.css';
import Seo from '~/components/Seo.astro';
import SiteHeader from '~/components/SiteHeader.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import { localeTags, useTranslations, type Lang, type RouteKey } from '~/i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  routeKey: RouteKey;
  image?: string | undefined;
  imageAlt?: string | undefined;
  /** Rutas de esta página por idioma cuando no salen de `routes` (ver Seo.astro). */
  langPaths?: Partial<Record<Lang, string>> | undefined;
  publishedAt?: Date | undefined;
  feed?: { href: string; title: string } | undefined;
  noindex?: boolean;
}

const { title, description, lang, routeKey, image, imageAlt, langPaths, publishedAt, feed, noindex = false } =
  Astro.props;
const t = useTranslations(lang);
---

<!doctype html>
<html lang={localeTags[lang]}>
  <head>
    <Seo
      title={title}
      description={description}
      lang={lang}
      routeKey={routeKey}
      image={image}
      imageAlt={imageAlt}
      langPaths={langPaths}
      publishedAt={publishedAt}
      feed={feed}
      noindex={noindex}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skipToContent')}</a>
    <SiteHeader lang={lang} routeKey={routeKey} langPaths={langPaths} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
