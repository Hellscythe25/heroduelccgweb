---
/**
 * Landing. Una sola plantilla para todos los idiomas: el contenido vive en
 * src/i18n/ (ui.ts y pages/home.ts), no duplicado por locale. Así la paridad
 * ES/EN es estructural y no depende de que alguien recuerde actualizar dos
 * archivos.
 *
 * La pieza fuerte es la alineación de los cinco héroes, como una pantalla de
 * selección: cada franja lleva a la ficha del héroe. Todo lo demás es sobrio a
 * propósito para no competir con el arte.
 *
 * Los CTA externos se renderizan solo si su URL existe en src/site.ts. Un botón
 * que lleva a ninguna parte es peor que la ausencia del botón. Mientras no
 * existan, los CTA llevan al interior del sitio.
 */
import { Picture } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import CtaLink from '~/components/CtaLink.astro';
import HeroEmblem from '~/components/HeroEmblem.astro';
import { brandEmblem, heroPortrait } from '~/art';
import { heroes } from '~/data';
import { heroPresentation } from '~/i18n/pages/heroes';
import { homeCopy } from '~/i18n/pages/home';
import { localizedPath, locales, useTranslations, type Lang, type UiKey } from '~/i18n/ui';
import { activeLinks } from '~/site';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const copy = homeCopy[lang];

const links = activeLinks();
const ctaLabels: Record<string, UiKey> = {
  steam: 'home.cta.steam',
  discord: 'home.cta.discord',
  itch: 'home.cta.itch',
};

const shortName = (name: string) => name.split(' ')[0];
const heroesPath = localizedPath(lang, 'heroes');
---

<BaseLayout
  title={`${t('site.name')} — ${t('site.tagline')}`}
  description={t('site.description')}
  lang={lang}
  routeKey="home"
>
  <section class="intro">
    <ul class="lineup">
      {
        heroes.map((hero, index) => {
          const portrait = heroPortrait(hero.id);
          return (
            <li style={`--hero: var(--hd-hero-${hero.id})`}>
              <a href={`${heroesPath}#${hero.id}`}>
                {portrait ? (
                  <Picture
                    src={portrait}
                    alt=""
                    formats={['avif', 'webp']}
                    widths={[240, 400, 640]}
                    sizes="(min-width: 52rem) 16vw, 20vw"
                    loading={index < 3 ? 'eager' : 'lazy'}
                    fetchpriority={index === 0 ? 'high' : 'auto'}
                    class="slice-art"
                  />
                ) : (
                  <HeroEmblem heroId={hero.id} glyph={heroPresentation[hero.id]!.glyph} size={96} />
                )}
                <span class="slice-name">{shortName(hero.name[lang])}</span>
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="embers" aria-hidden="true">
      {Array.from({ length: 14 }, () => <span />)}
    </div>

    <div class="container intro-copy">
      <Picture
        src={brandEmblem}
        alt=""
        formats={['avif', 'webp']}
        widths={[160, 320]}
        sizes="10rem"
        loading="eager"
        class="intro-emblem emblem-fade"
      />
      <p class="status">{t('home.badge')}</p>
      <h1>{t('home.title')}</h1>
      <p class="subtitle">{t('home.subtitle')}</p>
      <div class="actions">
        {
          links.map((link, index) => (
            <CtaLink href={link.url} external variant={index === 0 ? 'primary' : 'secondary'}>
              {t(ctaLabels[link.key]!)}
            </CtaLink>
          ))
        }
        <CtaLink href={localizedPath(lang, 'game')} variant={links.length > 0 ? 'secondary' : 'primary'}>
          {t('home.cta.game')}
        </CtaLink>
        <CtaLink href={localizedPath(lang, 'howToPlay')} variant="secondary">{t('home.cta.howToPlay')}</CtaLink>
      </div>
    </div>
  </section>

  <section class="section container" aria-label={t('nav.game')}>
    <ul class="pillars">
      {
        copy.pillars.map((pillar) => (
          <li>
            <h2 class="pillar-title">{pillar.title}</h2>
            <p>{pillar.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section container" aria-labelledby="home-heroes">
    <div class="heroes-head">
      <h2 id="home-heroes">{copy.heroes.title}</h2>
      <p>{copy.heroes.body}</p>
    </div>
    <ul class="roster">
      {
        heroes.map((hero) => (
          <li style={`--hero: var(--hd-hero-${hero.id}); --hero-text: var(--hd-hero-${hero.id}-text)`}>
            <a href={`${heroesPath}#${hero.id}`}>{shortName(hero.name[lang])}</a>
            <span class="roster-role">{heroPresentation[hero.id]!.role[lang]}</span>
            <span class="roster-life">
              {t('hero.life')} {hero.life}
            </span>
          </li>
        ))
      }
    </ul>
    <p class="more"><a href={heroesPath}>{copy.heroes.link}</a></p>
  </section>

  <section class="section container columns">
    <div>
      <h2>{copy.turn.title}</h2>
      <ol class="steps">
        {copy.turn.steps.map((step) => <li>{step}</li>)}
      </ol>
      <p class="more"><a href={localizedPath(lang, 'howToPlay')}>{t('home.cta.howToPlay')}</a></p>
    </div>
    <div>
      <h2>{copy.fair.title}</h2>
      <ul class="fair">
        {copy.fair.items.map((item) => <li>{item}</li>)}
      </ul>
      <p class="more"><a href={localizedPath(lang, 'game')}>{copy.fair.link}</a></p>
    </div>
  </section>

  <section class="section container closing" aria-labelledby="home-status">
    <h2 id="home-status">{copy.status.title}</h2>
    <p>{copy.status.body}</p>
    <div class="ornament" aria-hidden="true"><span></span></div>
  </section>
</BaseLayout>

<style>
  /* ---- Portada: alineación de héroes ---- */
  .intro {
    position: relative;
    isolation: isolate;
    display: grid;
    border-block-end: 1px solid var(--hd-border-gold);
  }

  .lineup {
    display: flex;
    block-size: clamp(16rem, 62vw, 22rem);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow: hidden;
  }

  .lineup li {
    position: relative;
    flex: 1 1 0;
    min-inline-size: 0;
    transition: flex-grow 320ms var(--hd-motion-ease);
    animation: slice-in 700ms var(--hd-motion-ease) both;
  }

  /* Entrada escalonada de los héroes: el único momento animado de la página. */
  .lineup li:nth-child(2) {
    animation-delay: 90ms;
  }
  .lineup li:nth-child(3) {
    animation-delay: 180ms;
  }
  .lineup li:nth-child(4) {
    animation-delay: 270ms;
  }
  .lineup li:nth-child(5) {
    animation-delay: 360ms;
  }

  @keyframes slice-in {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
  }

  /* ---- Brasas que suben desde la forja ---- */
  .embers {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .embers span {
    position: absolute;
    inset-block-end: -1rem;
    inset-inline-start: var(--x);
    inline-size: var(--s, 4px);
    block-size: var(--s, 4px);
    border-radius: 50%;
    background: var(--hd-gold-300);
    box-shadow: 0 0 10px 2px var(--hd-ember);
    opacity: 0;
    animation: ember-rise var(--d, 9s) linear var(--w, 0s) infinite;
  }

  .embers span:nth-child(1) { --x: 48%; --d: 9s; --w: 0s; }
  .embers span:nth-child(2) { --x: 55%; --d: 11s; --w: 2s; --s: 3px; }
  .embers span:nth-child(3) { --x: 61%; --d: 8s; --w: 4s; }
  .embers span:nth-child(4) { --x: 67%; --d: 12s; --w: 1s; --s: 5px; }
  .embers span:nth-child(5) { --x: 72%; --d: 10s; --w: 6s; --s: 3px; }
  .embers span:nth-child(6) { --x: 78%; --d: 9s; --w: 3s; }
  .embers span:nth-child(7) { --x: 83%; --d: 13s; --w: 5s; --s: 3px; }
  .embers span:nth-child(8) { --x: 88%; --d: 10s; --w: 7s; }
  .embers span:nth-child(9) { --x: 93%; --d: 11s; --w: 2.5s; --s: 5px; }
  .embers span:nth-child(10) { --x: 58%; --d: 14s; --w: 8s; --s: 3px; }
  .embers span:nth-child(11) { --x: 75%; --d: 12s; --w: 9s; }
  .embers span:nth-child(12) { --x: 86%; --d: 9s; --w: 10s; --s: 3px; }
  .embers span:nth-child(13) { --x: 64%; --d: 10s; --w: 11s; }
  .embers span:nth-child(14) { --x: 96%; --d: 13s; --w: 4.5s; --s: 3px; }

  @keyframes ember-rise {
    0% {
      opacity: 0;
      transform: translate(0, 0);
    }
    15% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      transform: translate(-3rem, -32rem);
    }
  }

  .intro-copy :global(.intro-emblem) {
    inline-size: clamp(5rem, 12vw, 8rem);
    block-size: auto;
    margin-block-end: var(--hd-space-4);
    filter: drop-shadow(0 0 24px var(--hd-gold-glow));
  }

  /* Franjas inclinadas que se solapan, como una pantalla de selección. */
  .lineup li + li {
    margin-inline-start: -2.5rem;
  }

  .lineup a {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: end center;
    overflow: hidden;
    clip-path: polygon(2.5rem 0, 100% 0, calc(100% - 2.5rem) 100%, 0 100%);
    background: var(--hd-surface-raised);
    color: var(--hd-text);
    text-decoration: none;
  }

  .lineup li:first-child a {
    clip-path: polygon(0 0, 100% 0, calc(100% - 2.5rem) 100%, 0 100%);
  }

  .lineup li:last-child a {
    clip-path: polygon(2.5rem 0, 100% 0, 100% 100%, 0 100%);
  }

  .lineup a::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, var(--hd-veil-strong) 0%, var(--hd-veil-clear) 45%);
    box-shadow: inset 0 -3px 0 var(--hero);
  }

  .lineup :global(.slice-art) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 20%;
    filter: saturate(0.85) brightness(0.8);
    transition: filter 320ms var(--hd-motion-ease);
  }

  .lineup :global(.emblem) {
    position: absolute;
    inset: 0;
    margin: auto;
  }

  .slice-name {
    position: relative;
    z-index: 1;
    margin-block-end: var(--hd-space-4);
    font-family: var(--hd-font-display);
    font-weight: 700;
    font-size: var(--hd-text-lg);
    letter-spacing: 0.04em;
  }

  /* En un teléfono las franjas miden ~75 px y el nombre no cabe: se oculta a la
     vista pero sigue siendo el nombre accesible del enlace. La lista de héroes
     de más abajo los muestra completos. */
  @media (max-width: 51.99rem) {
    .slice-name {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  /* El héroe señalado se adelanta: responde al puntero y al teclado. */
  .lineup li:has(a:hover),
  .lineup li:has(a:focus-visible) {
    flex-grow: 1.7;
  }

  .lineup a:hover :global(.slice-art),
  .lineup a:focus-visible :global(.slice-art) {
    filter: none;
  }

  .lineup a:focus-visible {
    outline: none;
  }

  .lineup a:focus-visible::after {
    box-shadow:
      inset 0 -3px 0 var(--hero),
      inset 0 0 0 3px var(--hd-focus);
  }

  .intro-copy {
    padding-block: var(--hd-space-8) var(--hd-space-12);
  }

  .status {
    color: var(--hd-accent);
    font-weight: 700;
  }

  h1 {
    margin-block-start: var(--hd-space-2);
    font-size: var(--hd-text-display);
    line-height: 1;
    color: var(--hd-accent);
    text-shadow: 0 0 40px var(--hd-gold-glow);
  }

  .subtitle {
    margin-block-start: var(--hd-space-6);
    font-size: var(--hd-text-lg);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hd-space-3);
    margin-block-start: var(--hd-space-8);
  }

  /* En pantalla ancha la alineación ocupa la derecha y el texto se apoya en
     el lado oscuro, sin velo encima de las caras. */
  @media (min-width: 52rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
      min-block-size: min(46rem, 88vh);
      align-items: center;
    }

    .lineup {
      position: absolute;
      inset-block: 0;
      inset-inline: 44% 0;
      block-size: auto;
      z-index: -1;
    }

    .lineup li:first-child a {
      clip-path: polygon(2.5rem 0, 100% 0, calc(100% - 2.5rem) 100%, 0 100%);
    }

    .intro::before {
      content: '';
      position: absolute;
      inset-block: 0;
      inset-inline: 36% auto;
      inline-size: 12%;
      z-index: 0;
      background: linear-gradient(90deg, var(--hd-surface), var(--hd-veil-clear));
      pointer-events: none;
    }

    .intro-copy {
      position: relative;
      z-index: 1;
      padding-block: var(--hd-space-16);
    }

    .intro-copy > * {
      max-inline-size: 30rem;
    }
  }

  /* ---- Secciones ---- */
  .pillars {
    display: grid;
    gap: var(--hd-space-8);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    padding: 0;
    list-style: none;
  }

  .pillars li {
    padding-block-start: var(--hd-space-4);
    border-block-start: 1px solid var(--hd-border-gold);
  }

  .pillar-title {
    margin-block-end: var(--hd-space-2);
    font-size: var(--hd-text-xl);
    color: var(--hd-accent);
  }

  .pillars p {
    color: var(--hd-text-muted);
  }

  .heroes-head {
    display: grid;
    gap: var(--hd-space-4);
    margin-block-end: var(--hd-space-8);
  }

  .heroes-head p {
    color: var(--hd-text-muted);
  }

  .roster {
    display: grid;
    gap: 0;
    padding: 0;
    list-style: none;
  }

  .roster li {
    display: grid;
    grid-template-columns: 9rem 1fr auto;
    align-items: baseline;
    gap: var(--hd-space-4);
    padding-block: var(--hd-space-4);
    padding-inline-start: var(--hd-space-4);
    border-block-end: 1px solid var(--hd-border);
    border-inline-start: 3px solid var(--hero);
  }

  .roster a {
    font-family: var(--hd-font-display);
    font-size: var(--hd-text-xl);
    font-weight: 700;
    color: var(--hd-text);
    text-decoration: none;
  }

  .roster a:hover {
    color: var(--hero-text);
  }

  .roster-role {
    color: var(--hd-text-muted);
  }

  .roster-life {
    color: var(--hd-text-muted);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 36rem) {
    .roster li {
      grid-template-columns: 1fr auto;
    }

    .roster-role {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  .more {
    margin-block-start: var(--hd-space-6);
    font-weight: 700;
  }

  .columns {
    display: grid;
    gap: var(--hd-space-12);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }

  .columns h2 {
    margin-block-end: var(--hd-space-6);
  }

  .fair {
    display: grid;
    gap: var(--hd-space-3);
    padding: 0;
    list-style: none;
  }

  .fair li {
    position: relative;
    padding-inline-start: var(--hd-space-6);
  }

  .fair li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.2rem;
    inset-block-start: 0.55em;
    inline-size: 0.45rem;
    block-size: 0.45rem;
    background: var(--hd-accent);
    transform: rotate(45deg);
  }

  .closing {
    text-align: center;
  }

  .closing h2 {
    margin-block-end: var(--hd-space-3);
  }

  .closing p {
    margin-inline: auto;
    color: var(--hd-text-muted);
  }

  .closing .ornament {
    margin-inline: auto;
  }
</style>
