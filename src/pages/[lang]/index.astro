---
/**
 * Landing. Una sola plantilla para todos los idiomas: el contenido vive en
 * src/i18n/ui.ts, no duplicado por locale. Así la paridad ES/EN es estructural
 * y no depende de que alguien recuerde actualizar dos archivos.
 *
 * Los CTA se renderizan solo si su URL existe en src/site.ts. Un botón que
 * lleva a ninguna parte es peor que la ausencia del botón: gasta la atención
 * del visitante una sola vez y la gasta mal.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import CtaLink from '~/components/CtaLink.astro';
import { locales, useTranslations, type Lang, type UiKey } from '~/i18n/ui';
import { activeLinks } from '~/site';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const links = activeLinks();
const ctaLabels: Record<string, UiKey> = {
  steam: 'home.cta.steam',
  discord: 'home.cta.discord',
  itch: 'home.cta.itch',
};
---

<BaseLayout
  title={`${t('site.name')} — ${t('site.tagline')}`}
  description={t('site.description')}
  lang={lang}
  routeKey="home"
>
  <section class="hero container">
    <p class="badge">{t('home.badge')}</p>
    <h1>{t('home.title')}</h1>
    <p class="subtitle">{t('home.subtitle')}</p>

    {
      links.length > 0 && (
        <div class="actions">
          {links.map((link, index) => (
            <CtaLink href={link.url} external variant={index === 0 ? 'primary' : 'secondary'}>
              {t(ctaLabels[link.key]!)}
            </CtaLink>
          ))}
        </div>
      )
    }
  </section>

  <section class="container building">
    <h2>{t('home.building.title')}</h2>
    <p>{t('home.building.body')}</p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--hd-space-16) var(--hd-space-8);
  }

  .badge {
    display: inline-block;
    margin-block-end: var(--hd-space-4);
    padding: var(--hd-space-1) var(--hd-space-3);
    border: 1px solid var(--hd-accent);
    border-radius: var(--hd-radius-full);
    color: var(--hd-accent);
    font-size: var(--hd-text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .subtitle {
    margin-block-start: var(--hd-space-4);
    font-size: var(--hd-text-lg);
    color: var(--hd-text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hd-space-3);
    margin-block-start: var(--hd-space-8);
  }

  .building {
    padding-block: var(--hd-space-8) var(--hd-space-16);
  }

  .building h2 {
    margin-block-end: var(--hd-space-3);
  }

  .building p {
    color: var(--hd-text-muted);
  }
</style>
