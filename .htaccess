# ---------------------------------------------------------------
#  Sitio estático (Astro). Namecheap / cPanel — Apache 2.4 o LiteSpeed
#
#  Este archivo se versiona en public/ y viaja dentro de dist/.
#  Por eso `rsync --delete` es seguro: nunca se pierde.
#  NUNCA editarlo por File Manager en el servidor — el siguiente
#  despliegue lo sobrescribe (docs/DEPLOY.md §9).
#
#  El dominio canónico lo inyecta scripts/postbuild.mjs a partir de
#  la variable de entorno SITE_URL. Si el token de sustitución
#  sobrevive al build, scripts/check-placeholders.mjs rompe el
#  pipeline antes de que nada llegue al servidor.
# ---------------------------------------------------------------

Options -Indexes +FollowSymLinks
DirectoryIndex index.html
DirectorySlash On
ErrorDocument 404 /404.html

AddDefaultCharset UTF-8

# --- 1. HTTPS + host canonico en un solo salto ---
RewriteEngine On

# No tocar el reto ACME de AutoSSL
RewriteCond %{REQUEST_URI} !^/\.well-known/

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://heroduelccg.com%{REQUEST_URI} [L,R=301]

# --- 2. Cabeceras de seguridad ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  # CSP: arranca en Report-Only. Pasar a enforce solo después de una
  # semana de reportes limpios (docs/DEPLOY.md §14).
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

# --- 3. Cache ---
<IfModule mod_headers.c>
  # Assets con hash de contenido -> inmutables un año
  <FilesMatch "\.[0-9a-zA-Z_-]{8}\.(js|css|woff2|avif|webp|png|jpe?g|svg|gif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Assets sin hash (favicon, OG, arte en /public) -> una semana
  <FilesMatch "\.(woff2|avif|webp|png|jpe?g|svg|gif|ico)$">
    Header setifempty Cache-Control "public, max-age=604800"
  </FilesMatch>

  # HTML y feeds -> siempre revalidar
  <FilesMatch "\.(html|xml|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# --- 4. Compresión ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- 5. Bloqueos ---
# OJO: no bloquear .json (lo consumen el catálogo y el deckbuilder).
# pagefind emite .pf_meta / .pf_fragment: tampoco deben bloquearse.
<FilesMatch "(^\.(?!well-known)|\.(map|md|mdx|yml|yaml|log|bak|sql|env|ts)$)">
  Require all denied
</FilesMatch>
